 "eif": [
  {
   "id": "EIF-01",
   "name": "Open Library catalog (search.json and work lookup)",
   "ret": 1,
   "dets": [
    "key (work key)",
    "title",
    "subtitle",
    "author_name",
    "author_key",
    "first_publish_year",
    "cover_i (cover id)",
    "number_of_pages_median",
    "subject",
    "isbn"
   ],
   "note": "Read-only HTTP GET to the Open Library API by OpenLibraryClient (search and findByWorkKey). Maintained by another application; the app stores only copies of the books the reader adds."
  }
 ],
 "operator_commands": [
  "php artisan moderation:reports - list the open reports about posts and comments, oldest first",
  "php artisan moderation:hide {type} {id} - hide a post or a comment from everybody but its author and close its reports",
  "php artisan moderation:restore {type} {id} - show a hidden post or comment again and close its reports",
  "php artisan moderation:resolve {report} - mark one report as looked at without changing visibility"
 ],
 "algorithms": [
  {
   "name": "Reading streak calculation (current and longest run of days with net positive pages, in the reader's time zone)",
   "where": "backend/app/Services/Stats/ReadingStatistics.php (streak)"
  },
  {
   "name": "Reading pace (average pages per day over a 14-day window)",
   "where": "backend/app/Services/Stats/ReadingStatistics.php (pace, dailyPages)"
  },
  {
   "name": "Per-book pace and forecast of the finishing date (pages left / pace, bounded to 730 days)",
   "where": "backend/app/Services/Stats/ReadingStatistics.php (forecasts)"
  },
  {
   "name": "Yearly goal progress (expected and due books by day of year, on-track flag)",
   "where": "backend/app/Services/Stats/GoalProgress.php"
  },
  {
   "name": "Quote of the day (deterministic pick by crc32 of user id and local date)",
   "where": "backend/app/Actions/Quotes/PickQuoteOfTheDay.php"
  },
  {
   "name": "Reading log from progress change (net pages delta, status transitions, finish sets last page)",
   "where": "backend/app/Actions/Library/UpdateProgress.php, RecordReadingLog.php, ChangeUserBookStatus.php"
  },
  {
   "name": "EPUB import: safe archive and XML reading, limits, DRM check, chapter extraction",
   "where": "backend/app/Services/Epub/EpubImporter.php, EpubArchive.php, PackageReader.php, SafeXml.php"
  },
  {
   "name": "EPUB HTML sanitizer (whitelist of elements and attributes)",
   "where": "backend/app/Services/Epub/HtmlSanitizer.php"
  },
  {
   "name": "Server-side verification of a quote anchor against chapter text (offset slice and text skeleton comparison)",
   "where": "backend/app/Actions/Reader/ResolveQuoteAnchor.php"
  },
  {
   "name": "UTF-16 offset resolution between DOM selection and chapter text (anchor offsets, highlight ranges, code-point alignment)",
   "where": "frontend/src/utils/readerDom.ts"
  },
  {
   "name": "Reading position to overall progress, debounced position saver",
   "where": "backend/app/Actions/Reader/SaveReadingPosition.php, frontend/src/composables/usePositionSaver.ts"
  },
  {
   "name": "Quote card canvas rendering (text wrapping, font fitting, word breaking, three templates)",
   "where": "frontend/src/utils/quoteCard.ts"
  },
  {
   "name": "Auto-hide of content after 3 open reports (moderation threshold)",
   "where": "backend/app/Actions/Social/ReportContent.php, ModerateContent.php"
  }
 ]
}