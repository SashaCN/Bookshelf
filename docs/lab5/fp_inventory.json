    "error message"
   ],
   "ftrs": [
    "Quotes"
   ]
  },
  {
   "id": "EI-16",
   "type": "EI",
   "name": "Set or change the yearly reading goal",
   "route": "PUT /api/goals/{year}",
   "screen": "components/GoalCard.vue (views/StatsView.vue)",
   "dets": [
    "target books",
    "button Save",
    "error message"
   ],
   "ftrs": [
    "Goals"
   ]
  },
  {
   "id": "EI-17",
   "type": "EI",
   "name": "Remove the yearly reading goal",
   "route": "DELETE /api/goals/{year}",
   "screen": "components/GoalCard.vue (views/StatsView.vue)",
   "dets": [
    "button Remove goal",
    "error message"
   ],
   "ftrs": [
    "Goals"
   ]
  },
  {
   "id": "EI-18",
   "type": "EI",
