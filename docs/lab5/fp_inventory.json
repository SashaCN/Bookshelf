{
 "transactions": [
  {
   "id": "EI-01",
   "type": "EI",
   "name": "Register an account",
   "route": "POST /api/auth/register",
   "screen": "views/RegisterView.vue",
   "dets": [
    "name",
    "email",
    "password",
    "button Create account",
    "error message"
   ],
   "ftrs": [
    "Users"
   ],
   "note": "Fortify; handle is generated server-side from the name (GenerateHandle), timezone defaults to Europe/Kyiv."
  },
  {
   "id": "EI-02",
   "type": "EI",
   "name": "Sign in",
   "route": "POST /api/auth/login",
   "screen": "views/LoginView.vue",
   "dets": [
    "email",
    "password",
    "button Sign in",
    "error message"
   ],
   "ftrs": [
    "Users"
   ],
   "note": "Creates a Sanctum cookie session; session table is technical and not counted."
  },
  {
   "id": "EI-03",
   "type": "EI",
   "name": "Sign out",
   "route": "POST /api/auth/logout",
   "screen": "views/ProfileView.vue",
   "dets": [
    "button Log out",
    "error message"
   ],
   "ftrs": [
    "Users"
   ]
  },
  {
   "id": "EI-04",
   "type": "EI",
   "name": "Edit own profile (name, handle, bio, timezone)",
   "route": "PATCH /api/me",
   "screen": "views/ProfileView.vue",
   "dets": [
    "name",
    "handle",
    "bio",
    "timezone",
    "button Save",
    "confirmation/error message"
   ],
   "ftrs": [
    "Users"
   ]
  },
  {
   "id": "EI-05",
   "type": "EI",
   "name": "Add a catalog book to the library",
   "route": "POST /api/library (openlibrary_work_key)",
   "screen": "views/AddBookView.vue",
   "dets": [
    "selected catalog entry (work key)",
    "button Add",
    "error message"
   ],
   "ftrs": [
    "Library",
    "Catalog",
    "OpenLibrary"
   ],
   "note": "Server looks the work up in Open Library when the book is not stored yet, stores Book+Authors and creates the library entry (EIF read + ILF writes). The user fills no field; the selected entry counts as one DET."
  },
  {
   "id": "EI-06",
   "type": "EI",
   "name": "Add a book manually",
   "route": "POST /api/library (title, authors, ...)",
   "screen": "views/AddBookView.vue",
   "dets": [
    "title",
    "authors",
    "pages",
    "year",
    "button Add book",
    "error message"
   ],
   "ftrs": [
    "Library",
    "Catalog"
   ]
  },
  {
   "id": "EI-07",
   "type": "EI",
   "name": "Change reading status (start, finish, abandon, return to want)",
   "route": "PATCH /api/library/{id} (status)",
   "screen": "views/BookView.vue",
   "dets": [
    "status action button (start / finish / abandon / back to wishlist)",
    "error message"
   ],
   "ftrs": [
    "Library",
    "ReadingLog"
   ],
   "note": "Finishing sets current page to total pages and writes a reading-log row; counted once although the button label varies."
  },
  {
   "id": "EI-08",
   "type": "EI",
   "name": "Update reading progress (current page or +N quick step)",
   "route": "POST /api/library/{id}/progress",
   "screen": "components/ReadingCard.vue, components/PageJumpForm.vue (views/BookView.vue)",
   "dets": [
    "page",
    "button Save",
    "quick-step button +N",
    "error message"
   ],
   "ftrs": [
    "Library",
    "ReadingLog"
   ],
   "note": "Same process from the Reading screen and the book card. Writes a reading-log row (pages delta) and updates current page."
  },
  {
   "id": "EI-09",
   "type": "EI",
   "name": "Set total pages of a book",
   "route": "PATCH /api/library/{id} (total_pages)",
   "screen": "views/BookView.vue",
   "dets": [
    "total pages",
    "button Save",
    "error message"
   ],
   "ftrs": [
    "Library"
   ]
  },
  {
   "id": "EI-10",
   "type": "EI",
   "name": "Rate a book (1-5 stars)",
   "route": "PATCH /api/library/{id} (rating)",
   "screen": "views/BookView.vue",
   "dets": [
    "rating (star group)",
    "error message"
   ],
   "ftrs": [
    "Library"
   ]
  },
  {
   "id": "EI-11",
   "type": "EI",
   "name": "Remove a book from the library",
   "route": "DELETE /api/library/{id}",
   "screen": "views/BookView.vue",
   "dets": [
    "button Remove",
    "button Yes, remove",
    "error message"
   ],
   "ftrs": [
    "Library",
    "Catalog",
    "ReadingLog",
    "Quotes",
    "BookTexts"
   ],
   "note": "Cascade deletes log, quotes and text of the entry; a manual book left without readers is deleted from the catalog."
  },
  {
   "id": "EI-12",
   "type": "EI",
   "name": "Add a quote or insight",
   "route": "POST /api/library/{id}/quotes",
   "screen": "views/QuoteFormView.vue",
   "dets": [
    "book",
    "type (quote/insight)",
    "content",
    "note",
    "page",
    "button Save",
    "error message"
   ],
   "ftrs": [
    "Quotes",
    "Library"
   ]
  },
  {
   "id": "EI-13",
   "type": "EI",
   "name": "Edit a quote",
   "route": "PATCH /api/quotes/{id}",
   "screen": "views/QuoteFormView.vue",
   "dets": [
    "type (quote/insight)",
    "content",
    "note",
    "page",
    "button Save",
    "error message"
   ],
   "ftrs": [
    "Quotes"
   ]
  },
  {
   "id": "EI-14",
   "type": "EI",
   "name": "Delete a quote",
   "route": "DELETE /api/quotes/{id}",
   "screen": "components/QuoteCard.vue",
   "dets": [
    "button Delete",
    "button Yes, delete",
    "error message"
   ],
   "ftrs": [
    "Quotes"
   ],
   "note": "The same process is used for removing a highlight in the reader (components/reader/HighlightSheet.vue); not counted twice."
  },
  {
   "id": "EI-15",
   "type": "EI",
   "name": "Mark or unmark a quote as favorite",
   "route": "PATCH /api/quotes/{id} (is_favorite)",
   "screen": "components/QuoteCard.vue",
   "dets": [
